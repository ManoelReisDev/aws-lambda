{
  "name": "aws-lambda-event-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx scripts/dev.ts",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "node --import tsx --env-file-if-exists=.env server/index.ts",
    "build": "tsc --noEmit && vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/index.js && npm run build:lambda",
    "build:lambda": "esbuild lambda/handler.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/lambda/index.cjs",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@aws-sdk/client-lambda": "^3.1166.0",
    "express": "^5.3.0",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "sass": "^1.108.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
